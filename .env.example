# Server
PORT=8080
PUBLIC_BASE_URL=https://party.example.com
LAN_BASE_URL=https://party.home.arpa
# Nur dem lokalen Reverse Proxy vertrauen. Bei fester Adresse besser exakt setzen,
# z. B. TRUST_PROXY=192.168.66.30
TRUST_PROXY=loopback,linklocal,uniquelocal

# Spotify Developer Dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://party.example.com/api/admin/spotify/callback

# Mit `openssl rand -base64 48` jeweils neu erzeugen
SESSION_SECRET=
ENCRYPTION_KEY=

# Nur beim allerersten Admin-Login erforderlich
ADMIN_SETUP_TOKEN=

# Optional für Entwicklung und automatisierte Tests ohne Spotify
DEMO_MODE=false

# Optional: Controller-Takt und Vorlauf bis zum Festschreiben des nächsten Songs
CONTROLLER_INTERVAL_MS=5000
LOCK_BEFORE_END_MS=30000
